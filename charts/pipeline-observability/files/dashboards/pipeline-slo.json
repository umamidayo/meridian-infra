{
  "uid": "meridian-pipeline-slo",
  "title": "Meridian / Pipeline SLOs",
  "description": "Reliability and latency SLOs for GitHub Actions pipelines, with error budgets and burn rates.",
  "tags": [
    "meridian",
    "slo",
    "ci"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timezone": "browser",
  "graphTooltip": 1,
  "panels": [
    {
      "type": "row",
      "title": "Objectives ($window)",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Success SLI",
      "description": "Successful / (successful + failed) runs on the default branch. Cancelled runs are excluded.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "meridian_pipeline_success_ratio{workflow=~\"$workflow\",window=\"$window\"}",
          "legendFormat": "{{workflow}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "no data",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
