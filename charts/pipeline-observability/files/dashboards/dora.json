      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(meridian_dora_last_deployment_timestamp_seconds) * 1000",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
